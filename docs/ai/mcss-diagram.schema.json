{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cloud-solution-studio.voler.com/schemas/mcss-diagram-v1.json",
  "title": "MCSS Diagram Format v1.0.0",
  "description": "Contrato aberto de diagramas de arquitetura do MultiCloud Solution Studio para importação/exportação e interoperabilidade com IA.",
  "type": "object",
  "required": [
    "format",
    "schemaVersion",
    "metadata",
    "diagram"
  ],
  "properties": {
    "format": {
      "type": "string",
      "const": "mcss.diagram",
      "description": "Discriminador fixo de formato."
    },
    "schemaVersion": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "description": "Versão SemVer do contrato (ex: 1.0.0)."
    },
    "catalogVersion": {
      "type": "string",
      "description": "Versão informativa do catálogo de serviços."
    },
    "metadata": {
      "type": "object",
      "required": [
        "title"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "description": {
          "type": "string",
          "maxLength": 2000
        },
        "origin": {
          "type": "string",
          "enum": [
            "ai",
            "human",
            "export"
          ]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "additionalProperties": true
    },
    "diagram": {
      "type": "object",
      "required": [
        "nodes",
        "edges"
      ],
      "properties": {
        "nodes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/node"
          },
          "maxItems": 500
        },
        "edges": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/edge"
          },
          "maxItems": 1000
        },
        "drawings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/drawing"
          },
          "maxItems": 300
        },
        "scenes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/scene"
          },
          "maxItems": 50
        },
        "viewport": {
          "$ref": "#/$defs/viewport"
        },
        "settings": {
          "type": "object",
          "properties": {
            "snapToGrid": {
              "type": "boolean"
            },
            "showGrid": {
              "type": "boolean"
            },
            "reduceMotion": {
              "type": "boolean"
            }
          }
        }
      },
      "additionalProperties": true
    },
    "extensions": {
      "type": "object"
    }
  },
  "$defs": {
    "viewport": {
      "type": "object",
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "zoom": {
          "type": "number",
          "minimum": 0.1,
          "maximum": 5
        }
      }
    },
    "node": {
      "type": "object",
      "required": [
        "id",
        "kind",
        "label",
        "position"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "kind": {
          "type": "string",
          "enum": [
            "service",
            "generic",
            "group",
            "shape",
            "note",
            "text"
          ]
        },
        "label": {
          "type": "string",
          "maxLength": 256
        },
        "serviceId": {
          "type": "string",
          "description": "serviceId exato do catálogo quando kind=service (ex: gcp-cloud-run, aws-s3)."
        },
        "position": {
          "type": "object",
          "required": [
            "x",
            "y"
          ],
          "properties": {
            "x": {
              "type": "number"
            },
            "y": {
              "type": "number"
            }
          }
        },
        "size": {
          "type": "object",
          "properties": {
            "width": {
              "type": "number",
              "minimum": 1
            },
            "height": {
              "type": "number",
              "minimum": 1
            }
          }
        },
        "parentId": {
          "type": "string",
          "maxLength": 128
        },
        "properties": {
          "type": "object"
        },
        "notes": {
          "type": "string",
          "maxLength": 10000,
          "description": "Observações técnicas da solução."
        },
        "style": {
          "type": "object"
        }
      },
      "additionalProperties": true
    },
    "edge": {
      "type": "object",
      "required": [
        "id",
        "sourceId",
        "targetId"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "sourceId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "targetId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "sourceHandle": {
          "type": "string"
        },
        "targetHandle": {
          "type": "string"
        },
        "direction": {
          "type": "string",
          "enum": [
            "forward",
            "reverse",
            "bidirectional",
            "none"
          ]
        },
        "flowType": {
          "type": "string",
          "enum": [
            "http",
            "data",
            "events",
            "network",
            "auth",
            "generic",
            "logical"
          ]
        },
        "label": {
          "type": "string",
          "maxLength": 128
        },
        "animated": {
          "type": "boolean"
        },
        "notes": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "drawing": {
      "type": "object",
      "required": [
        "id",
        "points"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "points": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "x",
              "y"
            ],
            "properties": {
              "x": {
                "type": "number"
              },
              "y": {
                "type": "number"
              }
            }
          }
        },
        "strokeWidth": {
          "type": "number",
          "minimum": 1
        },
        "color": {
          "type": "string"
        },
        "layer": {
          "type": "number"
        }
      }
    },
    "scene": {
      "type": "object",
      "required": [
        "id",
        "order",
        "title"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "order": {
          "type": "integer",
          "minimum": 0
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "description": {
          "type": "string",
          "maxLength": 2000
        },
        "speakerNotes": {
          "type": "string",
          "maxLength": 10000,
          "description": "Roteiro e notas do apresentador exclusivo para a cena."
        },
        "viewport": {
          "$ref": "#/$defs/viewport"
        },
        "nodeHighlights": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "edgeHighlights": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "animatedEdgeIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}